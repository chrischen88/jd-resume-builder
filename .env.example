# Copy to .env.local and fill in. Everything runs locally except the AI API calls.

# Chat model for lib/ai/client.ts: "anthropic" (default) or "openai".
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
ANTHROPIC_MODEL=

# OpenAI. The key is always required: embeddings use OpenAI even when chat runs on Anthropic.
OPENAI_API_KEY=
# Required when AI_PROVIDER=openai.
OPENAI_MODEL=
# Optional embedding model override (default: text-embedding-3-small).
OPENAI_EMBEDDING_MODEL=

# Chroma vector DB. `npm run chroma` runs one locally on :8000 (data in data/chroma).
CHROMA_URL=http://localhost:8000

# Where the app keeps its SQLite db, uploads, and Chroma data (default: ./data).
DATA_DIR=
