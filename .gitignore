# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# real JDs and resumes (resumes contain personal details); keep them local
/tests/fixtures/jds/*
!/tests/fixtures/jds/.gitkeep
/tests/fixtures/resumes/*
!/tests/fixtures/resumes/.gitkeep

# local app data: SQLite db, uploaded files, Chroma
/data/

# golden test outputs (contain JD text)
/tests/golden/output/
